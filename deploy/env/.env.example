# Template variabili per il server OVH (B4).
# Copiare in /opt/step2connect/<ambiente>/.env (chmod 600, owner deploy).
# NON committare il file compilato. Commenti solo su righe proprie.

# ── Ambiente / infrastruttura ────────────────────────────────────────────────
# dev | prod
APP_ENV=dev
# Porta su 127.0.0.1 a cui punta Nginx: dev 5101, prod 5100
HOST_PORT=5101
ENV_FILE=/opt/step2connect/dev/.env
PUBLIC_URL=https://dev.step2connect.it
# Origin aggiuntive ammesse da CORS (separate da virgola)
CORS_ALLOWED_ORIGINS=https://dev.step2connect.it
# Reverse proxy davanti all'app (Nginx o Traefik): 1 hop
TRUST_PROXY=1
# Server con Traefik: rete Docker di Traefik (es. "web" su befor1).
# Lasciare vuoto/commentato se si usa Nginx sull'host.
# TRAEFIK_NETWORK=web

# ── AWS (server) ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET_NAME=

# ── Sessioni CMS / preview ───────────────────────────────────────────────────
# Generare con: openssl rand -hex 48   (diverso per DEV e PROD)
SESSION_SECRET=

# ── Cognito (incorporate nella build frontend: NON sono segreti) ─────────────
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
VITE_API_BASE_URL=

# ── Opzionali ────────────────────────────────────────────────────────────────
# DYNAMODB_USERS_TABLE=Step2Connect_Users
# DYNAMODB_PHONE_INDEX=
# DYNAMODB_REGION=
# SES_FROM_EMAIL=liveperson-team@b4service.it
