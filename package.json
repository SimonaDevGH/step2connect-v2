{
  "name": "step2connect-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,yellow \"vite --host 0.0.0.0 --port 5000\" \"node server/index.js\"",
    "dev:frontend": "vite --host 0.0.0.0 --port 5000",
    "dev:server": "nodemon server/index.js",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "migrate": "node scripts/migrate-to-s3.mjs",
    "user:role": "node scripts/set-user-role.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-ses": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1116.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "aws-amplify": "^6.19.0",
    "concurrently": "^9.2.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "lucide-react": "^0.447.0",
    "mime-types": "^3.0.2",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "sanitize-html": "^2.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5"
  }
}
